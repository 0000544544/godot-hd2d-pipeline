# ==============================================================================
# PIPELINE ZERO-EURO - VARIABLES D'ENVIRONNEMENT & CLÉS D'APIS
# ==============================================================================
# Copiez ce fichier en '.env' et complétez avec vos clés d'accès gratuites.

# ------------------------------------------------------------------------------
# 1. IA GÉNÉRATIVE & CODE INTELLIGENCE
# ------------------------------------------------------------------------------
# Google AI Studio (Gratuit sans carte bancaire - Gemini 1.5 Pro / Flash)
# Lien : https://aistudio.google.com/
GEMINI_API_KEY=votre_cle_gemini_ici

# Hugging Face (Pour accès Spaces Flux et Microsoft Trellis 2 en inference API)
# Lien : https://huggingface.co/settings/tokens
HF_TOKEN=hf_votre_token_ici

# ------------------------------------------------------------------------------
# 2. AUDIO & GAMEPLAY EN TEMPS RÉEL
# ------------------------------------------------------------------------------
# Groq Cloud (API ultra-rapide gratuite - Llama 3.3 70B & Gemma 2 9B & Whisper)
# Lien : https://console.groq.com/
GROQ_API_KEY=gsk_votre_cle_groq_ici

# ElevenLabs (Quota gratuit mensuel pour Sound Effects)
# Lien : https://elevenlabs.io/
ELEVENLABS_API_KEY=votre_cle_elevenlabs_ici

# ------------------------------------------------------------------------------
# 3. BACKEND, BASE DE DONNÉES & MÉMOIRE DES PNJ
# ------------------------------------------------------------------------------
# Supabase (Tier Gratuit - Base PostgreSQL + pgvector pour mémoire PNJ)
# Lien : https://supabase.com/
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_publique
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_privee

# Appwrite (Plan Education gratuit pour profils de joueurs et sauvegardes cloud)
# Lien : https://appwrite.io/
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=votre_id_projet_appwrite
APPWRITE_API_KEY=votre_cle_api_appwrite

# ------------------------------------------------------------------------------
# 4. MONITORING, TÉLÉMÉTRIE & BUGS
# ------------------------------------------------------------------------------
# Sentry (Plan Gratuit / Student Pack - 50k erreurs et 500 replays / an)
# Lien : https://sentry.io/
SENTRY_DSN=https://votre_dsn_sentry_ici
